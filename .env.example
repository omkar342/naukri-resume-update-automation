# ==============================================================================
# Naukri Credentials & Configuration (Template)
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your real .env file or accounts.json to public git repositories!

# ------------------------------------------------------------------------------
# OPTION A: Single Account (or Primary Account)
# ------------------------------------------------------------------------------
NAUKRI_EMAIL=your_email@example.com
NAUKRI_PASSWORD=your_naukri_password

# Default / Fallback Master resume file or directory (picks newest PDF if directory)
RESUME_PATH=/path/to/your/resume.pdf

# ------------------------------------------------------------------------------
# OPTION B: Multiple Accounts via .env (Numbered entries)
# You can define separate emails, passwords, names, and individual resumes!
# If RESUME_PATH_<N> is omitted, it automatically falls back to default RESUME_PATH.
# ------------------------------------------------------------------------------
# NAUKRI_NAME_1="Primary Profile"
# NAUKRI_EMAIL_1=primary_email@example.com
# NAUKRI_PASSWORD_1=your_first_password
# RESUME_PATH_1=/path/to/first_resume.pdf
# RESUME_RENAME_MODE_1=date_time

# NAUKRI_NAME_2="Secondary Profile"
# NAUKRI_EMAIL_2=secondary_email@example.com
# NAUKRI_PASSWORD_2=your_second_password
# RESUME_PATH_2=/path/to/second_resume.pdf
# RESUME_RENAME_MODE_2=date_time

# ------------------------------------------------------------------------------
# OPTION C: Multiple Accounts via JSON File (Optional)
# If set, or if 'accounts.json' exists in the project root, accounts are loaded from it.
# See 'accounts.example.json' for the format.
# ------------------------------------------------------------------------------
# ACCOUNTS_FILE=accounts.json

# Delay in seconds between processing consecutive accounts
DELAY_BETWEEN_ACCOUNTS=5

# ==============================================================================
# Global Resume Renaming Mode (applied if an account has no specific mode)
# Options:
#   - date_time  : (Name first) -> Resume_2026-09-25_203512.pdf
#   - date_first : (Date first) -> 2026-09-25_Resume_203512.pdf
#   - timestamp  : Unix timestamp     -> Resume_1727276712.pdf
#   - date_only  : Date only          -> Resume_2026-09-25.pdf
# ==============================================================================
RESUME_RENAME_MODE=date_time

# Headless mode:
# Set to 'false' (recommended initially) so you can see the browser window
# and manually solve any OTP or CAPTCHA if Naukri asks.
HEADLESS=false

# Keep the temporary renamed copy after uploading? (true/false)
KEEP_RENAMED_COPY=false

# Timeout in seconds to wait for login / OTP / Captcha completion per account
LOGIN_TIMEOUT=120
